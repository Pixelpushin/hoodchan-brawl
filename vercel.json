{
  "buildCommand": "sh scripts/stamp-version.sh",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/mint-cron",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/mint-cron.js": {
      "maxDuration": 55
    },
    "api/status.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/src/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
