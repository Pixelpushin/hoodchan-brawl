{
  "openapi": "3.1.0",
  "info": {
    "title": "PFP Brawl API",
    "version": "1.1.0",
    "description": "Ambient match-record data for PFP Brawl, a generalized fighting game engine (see ADAPTERS.md). Tracks how many times each token ID has fought and won/lost in-game, namespaced per adapter via the `adapter` param (each adapter's own `config.key` from src/adapters/*/index.js) so two different collections' token #42 never share a record. Omitting `adapter` falls back to `onchainhoodies` for backward compatibility with clients built before this param existed. Unauthenticated by design, same trust model as the rest of the game (no wallet writes, nothing on-chain) - this is a fun social signal, not a verified competitive record. Source: https://github.com/Pixelpushin/pfp-brawl. Not deployed yet - no `servers` entry until a real deployment exists (see README's Deploying section)."
  },
  "paths": {
    "/api/hoodie/{tokenId}/stats": {
      "get": {
        "operationId": "getHoodieStats",
        "summary": "Get a token's in-game fight record",
        "parameters": [
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 0, "maximum": 10000000 }
          },
          {
            "name": "adapter",
            "in": "query",
            "description": "Which adapter's namespace to read from (matches that adapter's config.key). Defaults to onchainhoodies.",
            "schema": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Fight record for one token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tokenId": { "type": "integer" },
                    "wins": { "type": "integer" },
                    "losses": { "type": "integer" },
                    "matches": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid tokenId or adapter" }
        }
      }
    },
    "/api/matches/recent": {
      "get": {
        "operationId": "getRecentMatches",
        "summary": "Get the most recent completed matches for one adapter's collection",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          },
          {
            "name": "adapter",
            "in": "query",
            "description": "Which adapter's namespace to read from (matches that adapter's config.key). Defaults to onchainhoodies.",
            "schema": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent match feed, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "matches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tokenId": { "type": "integer" },
                          "opponentTokenId": { "type": ["integer", "null"] },
                          "result": { "type": "string", "enum": ["win", "loss"] },
                          "ts": { "type": "integer", "description": "Unix ms timestamp" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid adapter" }
        }
      }
    },
    "/api/leaderboard": {
      "get": {
        "operationId": "getLeaderboard",
        "summary": "Get the top fighters by win count for one adapter's collection",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 }
          },
          {
            "name": "adapter",
            "in": "query",
            "description": "Which adapter's namespace to read from (matches that adapter's config.key). Defaults to onchainhoodies.",
            "schema": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked fighters, highest win count first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fighters": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tokenId": { "type": "integer" },
                          "wins": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid adapter" }
        }
      }
    },
    "/api/rivalry/{tokenIdA}/{tokenIdB}": {
      "get": {
        "operationId": "getRivalry",
        "summary": "Get the head-to-head win record between two tokens",
        "description": "Order of tokenIdA/tokenIdB in the path doesn't matter - both orderings resolve to the same underlying record.",
        "parameters": [
          {
            "name": "tokenIdA",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 0, "maximum": 10000000 }
          },
          {
            "name": "tokenIdB",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 0, "maximum": 10000000 }
          },
          {
            "name": "adapter",
            "in": "query",
            "description": "Which adapter's namespace to read from (matches that adapter's config.key). Defaults to onchainhoodies.",
            "schema": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Head-to-head win record for this pairing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tokenIdA": { "type": "integer" },
                    "tokenIdB": { "type": "integer" },
                    "wins": {
                      "type": "object",
                      "description": "Win count for this pairing keyed by token ID (as a string)"
                    },
                    "matches": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid tokenIdA/tokenIdB or adapter" }
        }
      }
    },
    "/api/match-result": {
      "post": {
        "operationId": "postMatchResult",
        "summary": "Record the outcome of a completed match for one token",
        "description": "Called by the game client itself when a match ends. Unauthenticated - not designed to resist abuse, treat resulting stats as an ambient/fun signal rather than a verified record. When opponentTokenId is present this also updates that pairing's head-to-head record (see /api/rivalry/{tokenIdA}/{tokenIdB}), and a win also updates the adapter's leaderboard (see /api/leaderboard).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tokenId", "result"],
                "properties": {
                  "tokenId": { "type": "integer", "minimum": 0, "maximum": 10000000 },
                  "opponentTokenId": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000000 },
                  "result": { "type": "string", "enum": ["win", "loss"] },
                  "adapter": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,64}$",
                    "description": "Which adapter's namespace to write to (matches that adapter's config.key). Defaults to onchainhoodies."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Recorded" },
          "400": { "description": "Invalid body" }
        }
      }
    }
  }
}
